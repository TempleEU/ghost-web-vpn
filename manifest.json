{
  "manifest_version": 3,
  "name": "Ghost Web VPN",
  "version": "0.7.1",
  "description": "Privacy-focused browser proxy client with fail-closed protection, per-site routing, endpoint profiles and location coherence. Contact: ghostweb@ghostbin.cfd",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": ["alarms", "privacy", "proxy", "storage", "tabs", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>", "https://ipapi.co/*", "https://www.gstatic.com/*", "https://example.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}