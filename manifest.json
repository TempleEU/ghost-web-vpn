{
  "manifest_version": 3,
  "name": "Ghost Web VPN",
  "version": "0.1.0",
  "description": "Privacy-focused browser proxy client inspired by the one-click experience of BiuBiu VPN.",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["proxy", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": { "128": "icon.svg" }
}
