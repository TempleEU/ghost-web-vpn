{
  "manifest_version": 3,
  "name": "Ghost Web VPN",
  "version": "0.5.0",
  "description": "Privacy-focused browser proxy client for a self-hosted Ghost VPN endpoint. Contact: ghostweb@ghostbin.cfd",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["alarms", "proxy", "storage", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}